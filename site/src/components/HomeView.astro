---
// Shared home page: hero + chapter list. Rendered for all locales —
// en shows the English manuscript, ja the Japanese translation, yue the
// Cantonese translation.
import { getChapters, chapterMeta, readingMinutes } from '../lib/book';
import { t, LOGLINE, LOGLINE_JA, LOGLINE_YUE, localePath, type Locale } from '../i18n/ui';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const chapters = await getChapters(locale);
const metas = chapters.map((c) => chapterMeta(c, locale));
const totalWords = metas.reduce((sum, m) => sum + m.words, 0);
const totalMinutes = readingMinutes(totalWords, locale);
const firstSlug = metas[0]?.slug;
const readHref = firstSlug ? localePath(locale, `/chapters/${firstSlug}/`) : localePath(locale, '/');
---

<section class="hero">
	<div class="hero-inner">
		<p class="hero-kicker">{t(locale, 'homeKicker')}</p>
		<h1 class="hero-title">{t(locale, 'siteTitle')}</h1>
		{locale === 'yue' && (
			<p class="hero-subtitle" lang="yue">{t(locale, 'siteTitleYue')}</p>
		)}
		{locale === 'ja' && (
			<p class="hero-subtitle" lang="ja">{t(locale, 'siteTitleJa')}</p>
		)}
		{
			locale === 'ja' ? (
				<p class="hero-logline" lang="ja">{LOGLINE_JA}</p>
			) : locale === 'yue' ? (
				<p class="hero-logline" lang="yue">{LOGLINE_YUE}</p>
			) : (
				<p class="hero-logline" lang="en">{LOGLINE}</p>
			)
		}
		<div class="hero-actions">
			<a class="cta" href={readHref}>{t(locale, 'homeReadCta')}</a>
		</div>
	</div>
</section>

<section class="toc" id="toc">
	<header class="toc-head">
		<h2>{t(locale, 'homeContents')}</h2>
		<p class="toc-meta">
			{t(locale, 'homeMeta', {
				n: chapters.length,
				words: totalWords.toLocaleString('en-US'),
				minutes: totalMinutes,
			})}
		</p>
	</header>

	<ol class="toc-list">
		{
			metas.map((m) => (
				<li>
					<a class="toc-link" href={localePath(locale, `/chapters/${m.slug}/`)}>
						<span class="toc-num">{t(locale, 'chapterNum', { roman: m.roman, n: m.number })}</span>
						<span class="toc-title">{m.title}</span>
						<span class="toc-time">{t(locale, 'chapterTime', { minutes: m.minutes })}</span>
					</a>
				</li>
			))
		}
	</ol>
</section>