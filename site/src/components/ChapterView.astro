---
// Shared chapter reading page: sidebar + article + prev/next nav.
// en renders the English original; ja the Japanese translation; yue the
// Cantonese translation (`lang` is set accordingly for correct fonts and
// hyphenation).
import { render } from 'astro:content';
import ProgressBar from './ProgressBar.astro';
import ChapterSidebar from './ChapterSidebar.astro';
import { getChapters, chapterMeta, type Chapter, type ChapterMeta, type ChapterNavLink } from '../lib/book';
import { t, localePath, type Locale } from '../i18n/ui';

export interface Props {
	chapter: Chapter;
	meta: ChapterMeta;
	prev: ChapterNavLink | null;
	next: ChapterNavLink | null;
	locale: Locale;
}

const { chapter, meta, prev, next, locale } = Astro.props;
const chapters = await getChapters(locale);
const metas = chapters.map((c) => chapterMeta(c, locale));
const { Content } = await render(chapter);
const contentLang = locale === 'ja' ? 'ja' : locale === 'yue' ? 'yue' : 'en';
---

<div class="chapter-layout">
	<ChapterSidebar metas={metas} currentSlug={meta.slug} locale={locale} />

	<article class="chapter" lang={contentLang}>
		<ProgressBar />

		<header class="chapter-head prose">
			<p class="chapter-kicker">{t(locale, 'chapterKicker', { roman: meta.roman, n: meta.number })}</p>
			<h1>{meta.title}</h1>
			<p class="chapter-meta">
				{t(locale, 'chapterMeta', {
					minutes: meta.minutes,
					words: meta.words.toLocaleString('en-US'),
				})}
			</p>
		</header>

		<div class="prose chapter-body" lang={contentLang}>
			<Content />
		</div>

		<nav class="chapter-nav" aria-label={t(locale, 'navAria')}>
			{
				prev ? (
					<a class="nav-link" href={localePath(locale, `/chapters/${prev.slug}/`)} rel="prev">
						<span class="nav-label">{t(locale, 'chapterNavPrev')}</span>
						<span class="nav-title">{prev.title}</span>
					</a>
				) : (
					<span class="nav-empty"></span>
				)
			}
			{
				next ? (
					<a class="nav-link next" href={localePath(locale, `/chapters/${next.slug}/`)} rel="next">
						<span class="nav-label">{t(locale, 'chapterNavNext')}</span>
						<span class="nav-title">{next.title}</span>
					</a>
				) : (
					<span class="nav-empty"></span>
				)
			}
		</nav>
	</article>
</div>