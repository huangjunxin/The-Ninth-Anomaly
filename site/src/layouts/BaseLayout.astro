---
import '@fontsource/source-serif-4/latin-400.css';
import '@fontsource/source-serif-4/latin-400-italic.css';
import '@fontsource/source-serif-4/latin-600.css';
import '@fontsource/source-serif-4/latin-600-italic.css';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import SidebarToggle from '../components/SidebarToggle.astro';
import { t, LOGLINE, LOGLINE_JA, localePath, stripLocalePrefix, locales, type Locale } from '../i18n/ui';

interface Props {
	locale: Locale;
	title: string;
	description?: string;
	/** Thin reading progress bar (chapter pages). */
	showProgress?: boolean;
	/** Hamburger that opens the chapter sidebar (chapter pages). */
	showSidebarToggle?: boolean;
}

const { locale, title, description, showProgress = false, showSidebarToggle = false } =
	Astro.props;
const metaDescription = description ?? (locale === 'ja' ? LOGLINE_JA : LOGLINE);
const barePath = stripLocalePrefix(Astro.url.pathname);
---

<!doctype html>
<html lang={locale} data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={metaDescription} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:type" content="website" />
		<script is:inline>
			// Theme — apply the saved (or system-preferred) theme before first paint
			// to avoid a flash of the wrong colors. Defaults to `prefers-color-scheme`.
			(() => {
				let stored = null;
				try {
					stored = localStorage.getItem('tna-theme');
				} catch {
					/* storage unavailable (sandboxed) — fall through to system */
				}
				const dark =
					stored === 'dark' ||
					(!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
				document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
			})();

			// Language auto-selection — only for visitors who never chose manually.
			// zh-* browsers land on /zh/, ja-* on /ja/, everyone else on /. Once
			// the user has picked a language (via the switcher, stored in
			// `tna-lang`), their choice wins and no further redirects happen.
			(() => {
				let choice = null;
				try {
					choice = localStorage.getItem('tna-lang');
				} catch {
					/* fall through to detection */
				}
				if (choice === 'en' || choice === 'zh' || choice === 'ja') return;
				const nav = (navigator.language || '').toLowerCase();
				const target = nav.startsWith('zh') ? 'zh' : nav.startsWith('ja') ? 'ja' : 'en';
				const { pathname } = window.location;
				const m = pathname.match(/^\/(zh|ja)(?=\/|$)/);
				const current = m ? m[1] : 'en';
				if (target === current) return;
				const bare = m ? pathname.slice(m[1].length + 1) || '/' : pathname;
				const href = target === 'en' ? bare : bare === '/' ? `/${target}/` : `/${target}${bare}`;
				window.location.replace(href);
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">{t(locale, 'skipLink')}</a>
		<header class="site-header">
			<div class="header-left">
				{showSidebarToggle && <SidebarToggle label={t(locale, 'sidebarTitle')} />}
				<a class="site-title" href={localePath(locale, '/')}>
					{t(locale, 'siteTitle')}
					{locale === 'zh' && (
						<span class="site-title-zh" lang="zh">{t(locale, 'siteTitleZh')}</span>
					)}
					{locale === 'ja' && (
						<span class="site-title-zh" lang="ja">{t(locale, 'siteTitleJa')}</span>
					)}
				</a>
			</div>
			<div class="header-right">
				<nav class="lang-switch" aria-label="Language">
					{
						locales.map((l, i) => (
							<>
								{i > 0 && <span class="lang-slash">/</span>}
								<a
									class:list={['lang-opt', { cur: locale === l }]}
									href={localePath(l, barePath)}
									data-lang-target={l}
									aria-current={locale === l ? 'true' : undefined}
								>
									{t(locale, l === 'en' ? 'langEn' : l === 'zh' ? 'langZh' : 'langJa')}
								</a>
							</>
						))
					}
				</nav>
				<ThemeToggle label={t(locale, 'switchTheme')} />
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer">
			{t(locale, 'siteTitle')}<span class="footer-divider">·</span
			><span lang="zh">{t(locale, 'siteTitleZh')}</span><span class="footer-divider">·</span
			><span lang="ja">{t(locale, 'siteTitleJa')}</span>
			<br />
			<a href={localePath(locale, '/#toc')}>{t(locale, 'tocLink')}</a>
		</footer>

		<script>
			// Remember the manually chosen language when the switcher is used,
			// so the auto-selection script never overrides the visitor again.
			document.querySelectorAll('.lang-switch .lang-opt').forEach((link) => {
				link.addEventListener('click', () => {
					const target = link.getAttribute('data-lang-target');
					if (target) {
						try {
							localStorage.setItem('tna-lang', target);
						} catch {
							/* non-persistent context — navigation still happens */
						}
					}
				});
			});
		</script>
	</body>
</html>